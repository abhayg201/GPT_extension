{
  "name": "chrome-extension-typescript",
  "version": "1.0.0",
  "description": "Chrome extension with TypeScript and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:reload": "concurrently \"npm run dev\" \"npm run reload\"",
    "reload": "node scripts/reload.js",
    "build": "vite build",
    "build:debug": "vite build --mode development",
    "debug": "npm run build:debug && echo 'Extension built for debugging. Start Chrome with --remote-debugging-port=9222'",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/node": "^20.0.0",
    "chokidar": "^4.0.3",
    "concurrently": "^8.2.2",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^1.0.0",
    "ws": "^8.18.2"
  }
}