{
  "manifest_version": 3,
  "name": "Selected Text Viewer",
  "version": "1.0",
  "description": "Shows the selected text from the page in a popup.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content_script_module.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [
    {
      "resources": [
        "src/templates/*",
        "src/utils/*",
        "src/components/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}